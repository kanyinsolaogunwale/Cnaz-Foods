# ---------------------------------------------------------------------------
# Cnaz Foods — environment variables
#
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local` (it is git-ignored).
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the order API to write orders safely. Never exposed
# to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# --- Email providers ---------------------------------------------------------
# Priority order: Mailgun (if set) → Gmail SMTP (if set) → Resend.
# Mailgun needs a custom sending domain. Gmail SMTP is free and delivers to
# ANY recipient using a Gmail "App password" — the no-domain option. Resend's
# test sender only reaches the inbox that owns the Resend account.

# Mailgun (production, needs a domain) — Mailgun Dashboard → Sending → Domains
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Optional. Defaults to "Cnaz Foods <postmaster@YOUR_DOMAIN>".
MAILGUN_FROM=

# Gmail SMTP (free, no domain) — Google Account → Security → 2-Step
# Verification → App passwords (16 characters, spaces optional).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional. Defaults to "Cnaz Foods <GMAIL_USER>".
GMAIL_FROM=

# Resend (fallback/testing) — resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM=

# --- Paystack (online payment — optional until keys are added) ---------------
# paystack.com → Settings → API Keys & Webhooks. Test mode uses sk_test_…
# (no business registration needed); sk_live_… for real charges later.
# While empty, the online-payment UI is hidden and orders are confirmed by phone.
PAYSTACK_SECRET_KEY=

# --- Site -------------------------------------------------------------------
# Public base URL. Used for Google auth redirects and links inside emails.
# Local: http://localhost:3000 — Production: your deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Business contact details ----------------------------------------------
# Shown in the homepage contact section and the footer. Leave empty to hide
# the row. Use the real business phone/email.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
