# ---------------------------------------------------------------------------
# Cnaz Foods — environment variables
#
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local` (it is git-ignored).
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the order API to write orders safely. Never exposed
# to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# --- Mailgun (primary email provider) ---------------------------------------
# Mailgun Dashboard → Sending → Domains (API key under Account → API keys)
# Requires a custom sending domain (sandbox domains only deliver to verified
# authorized recipients).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Optional. Defaults to "Cnaz Foods <postmaster@YOUR_DOMAIN>".
MAILGUN_FROM=

# --- Resend (fallback email provider, optional) ------------------------------
# Used only when Mailgun is not configured. Resend works without a custom
# domain: create an API key at resend.com/api-keys and set RESEND_FROM to an
# email address you have verified on your Resend account.
RESEND_API_KEY=
RESEND_FROM=

# --- Site -------------------------------------------------------------------
# Public base URL. Used for Google auth redirects and links inside emails.
# Local: http://localhost:3000 — Production: your deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Business contact details ----------------------------------------------
# Shown in the homepage contact section and the footer. Leave empty to hide
# the row. Use the real business phone/email.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
