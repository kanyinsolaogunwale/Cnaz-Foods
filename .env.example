# ---------------------------------------------------------------------------
# Cnaz Foods — environment variables
#
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local` (it is git-ignored).
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the order API to write orders safely. Never exposed
# to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (default email provider — free, no custom domain needed) --------
# Create an API key at resend.com → API Keys. Without a verified domain,
# set RESEND_FROM to onboarding@resend.dev — Resend then only delivers to
# the inbox that owns the Resend account (fine for testing).
RESEND_API_KEY=
RESEND_FROM=

# --- Mailgun (activates automatically when filled — for production) ----------
# Mailgun needs a custom sending domain. When the business adds one, fill
# these in and they take priority over Resend with no code changes.
# Mailgun Dashboard → Sending → Domains (API key under Settings → API keys)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Optional. Defaults to "Cnaz Foods <postmaster@YOUR_DOMAIN>".
MAILGUN_FROM=

# --- Site -------------------------------------------------------------------
# Public base URL. Used for Google auth redirects and links inside emails.
# Local: http://localhost:3000 — Production: your deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Business contact details ----------------------------------------------
# Shown in the homepage contact section and the footer. Leave empty to hide
# the row. Use the real business phone/email.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
