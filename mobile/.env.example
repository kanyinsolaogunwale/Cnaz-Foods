# ---------------------------------------------------------------------------
# Cnaz Foods mobile app — environment
#
# Copy to .env.local and set your computer's LAN IP so a real phone on the
# same Wi-Fi can reach the website dev server:
#     Windows:  ipconfig   ->  IPv4 Address (Wi-Fi adapter)
#     macOS:    ipconfig getifaddr en0
#     Linux:    hostname -I | awk '{print $1}'
#
# Run `npm run sync-env` in this folder to copy the PUBLIC Supabase values
# from the website's .env.local (secrets are never copied — the app only ever
# receives the public URL + anon key, the same values the website's browser
# gets; Row Level Security remains the security boundary).
# ---------------------------------------------------------------------------

# The website the app talks to (catalogue API, orders API, Supabase bootstrap).
# On a real phone use your computer's LAN IP, NOT localhost.
EXPO_PUBLIC_WEBSITE_URL=http://localhost:3000

# Public Supabase project details (same project as the website).
# Fallback only — the app normally resolves these at runtime from
# <website>/api/mobile/config.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
